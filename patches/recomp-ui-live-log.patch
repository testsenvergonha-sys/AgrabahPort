+static void draw_live_log_view(const LauncherTheme& th) {
+    static char s_log_buf[65536];
+    static uint64_t s_last_seq = 0;
+    static size_t s_line_count = 0;
+    static bool s_auto_scroll = true;
+    static bool s_scroll_next = false;
+
+    uint64_t seq = 0;
+    size_t lines = 0;
+    recomp_live_log_copy(s_log_buf, sizeof(s_log_buf), &seq, &lines);
+    if (seq != s_last_seq) {
+        s_last_seq = seq;
+        s_line_count = lines;
+        if (s_auto_scroll) s_scroll_next = true;
+    }
+
+    ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0.05f, 0.06f, 0.09f, 0.94f));
+    ImGui::PushStyleColor(ImGuiCol_Border, imcol(th.border, 0.6f));
+    ImGui::PushStyleVar(ImGuiStyleVar_ChildRounding, px(8.0f));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(px(14.0f), px(10.0f)));
+    if (ImGui::BeginChild("##live_log_view", ImVec2(0, 0), ImGuiChildFlags_Borders)) {
+        // Toolbar row (clean left-to-right flow, zero overlapping)
+        ImGui::PushStyleColor(ImGuiCol_Text, col(th.accent2));
+        ImGui::AlignTextToFramePadding();
+        ImGui::Text("LIVE LOG  (%zu linhas)", s_line_count);
+        ImGui::PopStyleColor();
+
+        ImGui::SameLine(0, px(16.0f));
+        ImGui::Checkbox("Auto-scroll##livelog", &s_auto_scroll);
+
+        ImGui::SameLine(0, px(16.0f));
+        const float btn_h = ImGui::GetFrameHeight();
+        if (ImGui::Button("Copiar##livelog", ImVec2(px(74.0f), btn_h))) {
+            ImGui::SetClipboardText(s_log_buf);
+        }
+        ImGui::SameLine(0, px(8.0f));
+        if (ImGui::Button("Limpar##livelog", ImVec2(px(74.0f), btn_h))) {
+            recomp_live_log_clear();
+            s_log_buf[0] = '\0';
+            s_line_count = 0;
+        }
+        ImGui::SameLine(0, px(8.0f));
+        if (ImGui::Button("Voltar##livelog", ImVec2(px(74.0f), btn_h))) {
+            g_live_log_open = false;
+        }
+
+        ImGui::Dummy(ImVec2(0, px(4.0f)));
+        ImGui::Separator();
+        ImGui::Dummy(ImVec2(0, px(4.0f)));
+
+        // Scrollable console output
+        ImGui::PushStyleColor(ImGuiCol_ChildBg, ImVec4(0.03f, 0.035f, 0.055f, 0.98f));
+        if (ImGui::BeginChild("##live_log_scroll", ImVec2(0, 0), ImGuiChildFlags_None,
+                              ImGuiWindowFlags_HorizontalScrollbar)) {
+            if (s_log_buf[0] == '\0') {
+                ImGui::PushStyleColor(ImGuiCol_Text, col(th.text_muted));
+                ImGui::TextUnformatted("Aguardando eventos do runtime...");
+                ImGui::PopStyleColor();
+            } else {
+                const char* p = s_log_buf;
+                while (*p) {
+                    const char* nl = std::strchr(p, '\n');
+                    const char* end = nl ? nl : (p + std::strlen(p));
+                    std::string line(p, (size_t)(end - p));
+
+                    ImVec4 tint(0.84f, 0.88f, 0.94f, 1.0f);
+                    if (line.find("error") != std::string::npos ||
+                        line.find("ERROR") != std::string::npos ||
+                        line.find("failed") != std::string::npos ||
+                        line.find("FAILED") != std::string::npos) {
+                        tint = ImVec4(1.0f, 0.45f, 0.45f, 1.0f);
+                    } else if (line.find("warn") != std::string::npos ||
+                               line.find("WARN") != std::string::npos ||
+                               line.find("No joysticks") != std::string::npos) {
+                        tint = ImVec4(1.0f, 0.82f, 0.38f, 1.0f);
+                    } else if (line.rfind("[host", 0) == 0 ||
+                               line.rfind("[Launcher]", 0) == 0 ||
+                               line.rfind("[snes", 0) == 0) {
+                        tint = ImVec4(0.48f, 0.88f, 1.0f, 1.0f);
+                    }
+                    ImGui::PushStyleColor(ImGuiCol_Text, tint);
+                    ImGui::TextUnformatted(line.c_str(), line.c_str() + line.size());
+                    ImGui::PopStyleColor();
+
+                    if (!nl) break;
+                    p = nl + 1;
+                }
+            }
+            if (s_scroll_next) {
+                ImGui::SetScrollHereY(1.0f);
+                s_scroll_next = false;
+            }
+        }
+        ImGui::EndChild();
+        ImGui::PopStyleColor();
+    }
+    ImGui::EndChild();
+    ImGui::PopStyleVar(2);
+    ImGui::PopStyleColor(2);
+}
+#endif
