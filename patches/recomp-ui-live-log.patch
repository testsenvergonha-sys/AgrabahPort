+// "Agrabah" theme: Country-Box inspired night-desert palette (deep Agrabah
+// midnight navy/indigo ground, warm royal gold CTA/borders, genie turquoise
+// secondary accents, no CRT scanlines). Draws custom procedural art when
+// background_style == 2.
+static inline LauncherTheme launcher_theme_agrabah(void) {
+    LauncherTheme t = launcher_theme_default();
+    t.background      = lng_rgba(0.035f, 0.047f, 0.118f, 1.0f); // #090C1E midnight sky
+    t.background2     = lng_rgba(0.090f, 0.071f, 0.220f, 1.0f); // #171238 royal indigo
+    t.panel           = lng_rgba(0.067f, 0.086f, 0.180f, 0.96f); // #11162E card surface
+    t.panel_hovered   = lng_rgba(0.102f, 0.129f, 0.267f, 0.98f); // #1A2144
+    t.control         = lng_rgba(0.106f, 0.129f, 0.247f, 1.0f); // #1B213F
+    t.control_hovered = lng_rgba(0.153f, 0.188f, 0.345f, 1.0f); // #273058
+    t.border          = lng_rgba(0.839f, 0.647f, 0.227f, 0.48f); // #D6A53A warm gold rim
+    t.accent          = lng_rgba(0.957f, 0.769f, 0.259f, 1.0f); // #F4C442 magic gold
+    t.accent_dim      = lng_rgba(0.776f, 0.557f, 0.102f, 1.0f); // #C68E1A
+    t.accent_text     = lng_rgba(0.086f, 0.063f, 0.024f, 1.0f); // #161006 crisp dark ink
+    t.accent2         = lng_rgba(0.251f, 0.855f, 0.784f, 1.0f); // #40DAC8 genie aqua
+    t.text            = lng_rgba(0.957f, 0.941f, 0.902f, 1.0f); // #F4F0E6 warm ivory
+    t.text_muted      = lng_rgba(0.624f, 0.616f, 0.725f, 1.0f); // #9F9DB9
+    t.focus_ring      = lng_rgba(0.957f, 0.769f, 0.259f, 1.0f);
+    t.radius_sm       = 8.0f;
+    t.radius_lg       = 14.0f;
+    t.background_style = 2;
+    t.scanlines       = 0;
+    return t;
+}
