 static inline LauncherTheme launcher_theme_by_name(const char* name) {
+    if (name && (name[0]=='a' || name[0]=='A') &&
+        (name[1]=='g' || name[1]=='G') && (name[2]=='r' || name[2]=='R') &&
+        (name[3]=='a' || name[3]=='A') && (name[4]=='b' || name[4]=='B') &&
+        (name[5]=='a' || name[5]=='A') && (name[6]=='h' || name[6]=='H') && !name[7])
+        return launcher_theme_agrabah();
     if (name && (name[0]=='c' || name[0]=='C') &&
         (name[1]=='d' || name[1]=='D') && (name[2]=='i' || name[2]=='I') && !name[3])
         return launcher_theme_cdi();
