+static inline void cleanup_residual_staging() {
+#if defined(_WIN32)
+    namespace fs = std::filesystem;
+    std::error_code ec;
+    fs::path exe = get_exe_path();
+    if (exe.empty()) return;
+    fs::path staging = exe.parent_path() / L"_update_staging";
+    if (fs::exists(staging, ec))
+        fs::remove_all(staging, ec);
